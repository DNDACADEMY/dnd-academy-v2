  "author": "dnd-academy",
  "scripts": {
    "open-browser": "open http://dnd-academy.localhost:3000",
    "dev": "next dev --turbopack -H dnd-academy.localhost -p 3000 & pnpm open-browser",
    "build": "pnpm generate:applicant-count && next build --turbopack",
    "start": "next start",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm test:unit --coverage",
    "check-types": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:scripts": "tsc --project tsconfig.scripts.json",
    "generate:applicant-count": "pnpm build:scripts && node dist/scripts/generate-applicant-count.js"
  },
