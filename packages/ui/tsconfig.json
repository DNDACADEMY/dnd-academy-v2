{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "vite-plugin-svgr/client", "vitest/globals"]
  },
  "include": [
    "src",
    "index.d.ts",
    "server.d.ts",
    "client.d.ts",
    "vite.config.mts",
    "../../vitest.setup.ts",
    "__mocks__",
    "svg.d.ts"
  ],
  "exclude": ["dist", "build", "node_modules", "**/*.test.(ts|tsx)", "**/*.stories.(ts|tsx)"]
}
