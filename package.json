{
  "name": "dnd-academy-v2",
  "version": "1.0.0",
  "description": "DND는 개발자와 디자이너라면 누구나 참여할 수 있는 IT비영리단체입니다.",
  "license": "GPL-3.0-only",
  "author": "dnd-academy",
  "scripts": {
    "deploy": "turbo run deploy",
    "deploy:web": "turbo run deploy --filter=web",
    "deploy:admin": "turbo run deploy --filter=admin",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test:coverage": "turbo run test:coverage -- --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@turbo/gen": "2.10.13",
    "@types/eslint": "^8",
    "@types/jest-plugin-context": "2.9.7",
    "@types/node": "26.6.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.1",
    "jest-plugin-context": "2.9.0",
    "lefthook": "2.1.14",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DNDACADEMY/dnd-academy-v2.git"
  },
  "bugs": {
    "email": "dbd02169@naver.com",
