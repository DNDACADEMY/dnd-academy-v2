{
  "name": "dnd-academy-v2",
  "version": "1.0.0",
  "description": "DND는 개발자와 디자이너라면 누구나 참여할 수 있는 IT비영리단체입니다.",
  "license": "GPL-3.0-only",
  "author": "dnd-academy",
  "scripts": {
    "deploy": "turbo run deploy",
    "deploy:web": "turbo run deploy --filter=web",
    "deploy:admin": "turbo run deploy --filter=admin",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "test:coverage": "turbo run test:coverage -- --passWithNoTests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@turbo/gen": "2.11.3",
    "@types/node": "26.6.2",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postcss": "8.5.28",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DNDACADEMY/dnd-academy-v2.git"
  },
  "bugs": {
    "email": "dbd02169@naver.com",
    "url": "https://github.com/DNDACADEMY/dnd-academy-v2/issues"
  },
  "packageManager": "pnpm@12.6.0"
}
